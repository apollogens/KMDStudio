{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"KMDStudio local quality record",
  "type":"object","additionalProperties":false,
  "required":["version","scope","outcome","stages","findings"],
  "properties":{
    "version":{"const":1},
    "scope":{"enum":["layout-only","source-correction"]},
    "outcome":{"enum":["pass","partial","blocked"]},
    "stages":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/stage"}},
    "findings":{"type":"array","minItems":0,"maxItems":32,"items":{"$ref":"#/$defs/finding"}}
  },
  "$defs":{
    "note":{"type":"string","minLength":1,"maxLength":480},
    "id":{"type":"string","minLength":1,"maxLength":32,"pattern":"^[a-z][a-z0-9-]{0,31}$"},
    "reference":{
      "type":"object","additionalProperties":false,"required":["path","sha256"],
      "properties":{
        "path":{"type":"string","minLength":1,"maxLength":200},
        "sha256":{"type":"string","minLength":64,"maxLength":64,"pattern":"^[0-9a-f]{64}$"}
      }
    },
    "stage":{
      "type":"object","additionalProperties":false,"required":["brief","docx","render","change"],
      "properties":{
        "brief":{"$ref":"#/$defs/reference"},
        "docx":{"$ref":"#/$defs/reference"},
        "render":{"enum":["inspected","unavailable","pending"]},
        "renderer":{"$ref":"#/$defs/note"},
        "page_count":{"type":"integer","minimum":1,"maximum":100},
        "change":{"$ref":"#/$defs/note"}
      }
    },
    "finding":{
      "type":"object","additionalProperties":false,
      "required":["id","category","severity","evidence","correction","method","status","observed"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "block":{"$ref":"#/$defs/id"},
        "page":{"type":"integer","minimum":1,"maximum":100},
        "category":{"enum":["fidelity","structure","security","editability","accessibility","layout","visual","art-direction"]},
        "severity":{"enum":["blocker","major","minor","observation"]},
        "evidence":{"$ref":"#/$defs/note"},
        "correction":{"$ref":"#/$defs/note"},
        "method":{"enum":["source-compare","ooxml","application","render","human"]},
        "status":{"enum":["open","resolved","accepted"]},
        "observed":{"type":"integer","minimum":0,"maximum":3},
        "resolved":{"type":"integer","minimum":1,"maximum":3},
        "result":{"$ref":"#/$defs/note"}
      }
    }
  }
}
