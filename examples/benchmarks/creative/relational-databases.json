          "Анна"
        ],
        [
          "2",
          "Марк"
        ]
      ],
      "column_weights": [
        2,
        7
      ],
      "column_alignments": [
        "right",
        "left"
      ],
      "keep_rows": true
    },
    {
      "id": "books",
      "kind": "table",
      "caption": "Книги · books",
      "headers": [
        "id",
        "title",
        "author_id"
      ],
      "rows": [
        [
          "10",
          "Маяк",
          "1"
        ],
        [
          "11",
