      ],
      "column_weights": [
        2,
        6,
        3
      ],
      "column_alignments": [
        "right",
        "left",
        "right"
      ],
      "keep_rows": true
    },
    {
      "id": "match",
      "kind": "diagram",
      "caption": "Путь от автора к книге",
      "steps": [
        {
          "label": "1. Возьмите ключ автора",
          "detail": "У Анны значение authors.id равно 1."
        },
        {
          "label": "2. Найдите совпадения",
          "detail": "Две строки books содержат author_id = 1. Это «Маяк» и «Порт»."
        }
      ]
    },
    {
      "id": "join",
      "kind": "heading",
      "level": 1,
      "text": "От совпадений к результату",
      "new_page": true
    },
    {
      "id": "join-text",
      "kind": "paragraph",
      "text": "INNER JOIN возвращает строку для каждого совпадения. ORDER BY b.id задаёт порядок строк результата."
    },
    {
      "id": "query",
      "kind": "code",
      "language": "sql",
      "caption": "Запрос · автор и название книги",
      "text": "SELECT a.name, b.title\nFROM authors AS a\nJOIN books AS b ON b.author_id = a.id\nORDER BY b.id;"
    },
    {
      "id": "results",
      "kind": "table",
      "caption": "Результат запроса",
      "headers": [
        "Автор",
        "Книга"
      ],
      "rows": [
        [
          "Анна",
          "Маяк"
        ],
        [
          "Анна",
          "Порт"
        ],
        [
          "Марк",
          "Тропа"
        ]
      ],
      "column_weights": [
        5,
        5
      ],
      "column_alignments": [
        "left",
        "left"
      ],
      "keep_rows": true
    },
    {
      "id": "exercise",
      "kind": "exercise",
      "title": "Проверьте себя",
      "intro": "Добавьте автора без книг. Сначала предскажите результат, затем сравните два запроса.",
      "steps": [
        "Добавьте в authors автора с id = 3.",
        "Выполните исходный запрос и проверьте число строк.",
        "Замените JOIN на LEFT JOIN и снова проверьте результат."
      ],
      "check": "INNER JOIN по-прежнему возвращает три строки. LEFT JOIN добавляет строку нового автора со значением NULL в столбце названия."
    }
  ]
